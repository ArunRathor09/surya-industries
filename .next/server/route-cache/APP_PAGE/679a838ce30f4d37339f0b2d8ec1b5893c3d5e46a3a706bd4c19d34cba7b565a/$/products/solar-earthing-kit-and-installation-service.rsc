b:["$","$L16",null,{"product":{"id":18,"slug":"solar-earthing-kit-and-installation-service","name":"Solar Earthing Kit & Solar Installation Service","category":"Services","summary":"Earthing and lightning protection for solar plants, with support for solar companies.","description":"Solar plant earthing and lightning protection products and installation support for solar companies.","specifications":[{"label":"Service","value":"Solar plant earthing and lightning protection"},{"label":"Support","value":"Solar company earthing support"},{"label":"Service scope","value":"Site assessment, system planning and installation; confirm project scope with SPI"},{"label":"System options","value":"Grid-tied, off-grid or hybrid, based on site and utility requirements"},{"label":"Typical components","value":"Panels, inverter, mounting structure, wiring, optional batteries and monitoring as specified"},{"label":"Service life reference","value":"Solar modules commonly have a 25–30 year design life; product warranties vary by manufacturer"}],"features":["Solar plant earthing","Solar lightning protection","Installation support"],"applications":["Rooftop and ground-mounted solar projects","Grid-tied, off-grid and hybrid systems, subject to project design","Solar companies requiring earthing support"],"guideSections":[{"title":"Solar installation process","paragraphs":["SPI solar service enquiries can cover site assessment, system planning and installation. The final scope depends on the site, energy use, utility requirements and selected equipment."],"steps":["Assess roof or ground conditions, orientation, shading and available solar exposure.","Review electricity bills and energy consumption; a south-facing orientation is often favorable in the northern hemisphere, but shading and site layout determine the final array direction.","Decide whether the project is grid-tied, off-grid or hybrid.","Design the system around the selected panels, inverter, mounting, cabling, protection, optional batteries and monitoring.","Coordinate applicable permissions, utility approvals and grid-connection requirements.","Install mounting, panels, inverter, wiring and specified earthing/lightning-protection components.","Complete inspection, testing, commissioning and handover according to the agreed project scope."],"bullets":["System components may include solar modules, inverter, racking, DC/AC wiring, optional battery storage and monitoring.","Maintenance commonly includes periodic cleaning and checking system output; follow the component manufacturer's instructions.","The supplied notes cite a 25–30 year typical solar-module life; warranties vary by manufacturer and product.","Solar installation cost is project-specific and may be quoted per watt after site and scope review. Incentives and net-metering rules depend on local policy and utility approval."],"note":"SPI's exact service scope, equipment supply, approvals, cost and warranties must be confirmed in a project quotation. No generation or savings estimate is guaranteed without a site-specific assessment."}],"image":"/products/solar-earthing-kit.jpg","imageAlt":"Placeholder image for solar earthing kit and installation service"},"relatedProducts":[]}]
