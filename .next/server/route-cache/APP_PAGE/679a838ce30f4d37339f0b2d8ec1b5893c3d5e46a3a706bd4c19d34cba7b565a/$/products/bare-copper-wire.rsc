b:["$","$L16",null,{"product":{"id":19,"slug":"bare-copper-wire","name":"Bare Copper Wire","category":"Earthing","summary":"Uninsulated copper conductor for earthing, electrical bonding and lightning protection.","description":"Bare copper wire is an uninsulated copper conductor supplied in solid or stranded constructions. Its high conductivity makes it suitable for grounding and bonding connections; select the conductor size and construction for the current rating and installation design.","specifications":[{"label":"Material","value":"Copper; purity and grade to be confirmed for the selected conductor"},{"label":"Construction","value":"Solid or stranded"},{"label":"Insulation","value":"Bare / uninsulated"},{"label":"Conductor size","value":"Project-specific; confirm gauge or cross-sectional area with SPI"}],"features":["High electrical conductivity","Suitable for earthing and electrical bonding","Flexible stranded options for routing requirements","Reusable and recyclable copper material"],"applications":["Grounding systems","Electrical bonding","Lightning protection systems","Automotive, marine and industrial installations"],"guideSections":[{"title":"Conductor formats and sizing","paragraphs":["Bare copper wire has no insulation or protective outer covering. It can be supplied as a solid single conductor or as multiple stranded wires for added flexibility. Copper is highly conductive and recyclable."],"bullets":["The supplied notes give 8, 10 and 12 AWG as example gauges; these are examples, not a complete SPI size list.","Select wire gauge or cross-sectional area for fault-current duty, installation method, mechanical strength and applicable code.","Typical uses include grounding, electrical bonding, construction, automotive or marine work and lightning-protection connections."],"note":"Confirm copper grade, conductor size and certification with SPI before ordering; never infer a conductor's fault rating from gauge alone."}],"image":"/products/bare-copper-wire.jpg","imageAlt":"Illustration placeholder for bare copper earthing wire"},"relatedProducts":[{"id":7,"slug":"copper-bonded-solid-earth-rod","name":"Copper Bonded Solid Earth Rod","category":"Earthing","summary":"Copper-coated solid earth rod with 100–250 micron coating and 15+ years durability.","description":"A low-carbon steel core with electrolytically bonded copper coating combines mechanical strength with copper's corrosion resistance. The coating is 100–250 microns for long-lasting earthing performance.","specifications":[{"label":"Copper coating","value":"100–250 micron"},{"label":"Durability","value":"15+ years"},{"label":"Diameters","value":"14.2 / 17.2 / 20 / 25 / 32 mm"},{"label":"Lengths","value":"1 / 2 / 3 m"},{"label":"Additional common lengths","value":"1.2 / 1.5 / 2.4 m are cited in supplementary notes; confirm the selected size with SPI"},{"label":"Testing","value":"NABL & CPRI tested"}],"features":["99.9% pure copper bonding","High tensile strength","Highly conductive and anti-corrosive","Designed for low-maintenance service","NABL & CPRI tested","Copper bonding combines a mechanically strong steel core with a corrosion-resistant surface"],"guideSections":[{"title":"Construction and selection","paragraphs":["A copper-bonded rod uses a low-carbon or mild-steel core with electrolytically bonded copper. The steel provides mechanical strength while the copper surface provides conductivity and corrosion resistance. Copper purity and coating adhesion should be verified from the product certificate."],"bullets":["Supplementary notes cite common lengths of 1.2 m, 1.5 m, 2.4 m and 3 m in addition to the 1 m, 2 m and 3 m catalogue options.","Choose the rod diameter and length for the soil, mechanical conditions and earthing design.","Related accessories may include U-bolt or G-clamps, ground-enhancement material, earth-pit covers and exothermic-welding kits; confirm what is included in the SPI quotation.","The supplied notes refer to IEEE 80, UL 467, BS 7430 and IS 3043. Applicable standards depend on the project and product certification."],"note":"Size ranges and standards are selection references, not a substitute for checking current SPI stock, certificates and project specifications."}],"image":"/products/copper-bonded-solid-earth-rod.jpg","imageAlt":"Placeholder image for copper bonded solid earth rod"},{"id":8,"slug":"copper-bonded-chemical-earth-electrode","name":"Copper Bonded Chemical Earth Electrode","category":"Earthing","summary":"Copper-bonded chemical electrode with a crystalline conductive compound fill.","description":"A copper-bonded steel electrode with a copper-coated inner flat electrode and crystalline conductive compound filling. The compound helps retain moisture and support stable soil resistance.","specifications":[{"label":"Diameters","value":"48 mm and 76 mm"},{"label":"Additional typical diameters","value":"58 mm and 76–100 mm variants are mentioned in supplementary notes; confirm availability"},{"label":"Lengths","value":"1 / 2 / 3 m"},{"label":"Copper coating","value":"100–250 micron"},{"label":"Electrode","value":"Copper-coated inner flat electrode"},{"label":"Filling","value":"Crystalline conductive compound"},{"label":"Durability","value":"15+ years"},{"label":"Testing","value":"NABL & CPRI tested"}],"features":["Copper coating 100–250 microns","Crystalline conductive backfill","Corrosion-resistant construction","NABL & CPRI tested"],"applications":["Electrical substations","Data centres","Telecommunications","Solar power plants","High-rise buildings","Hospitals and sensitive electronics systems"],"guideSections":[{"title":"Electrode construction and benefits","paragraphs":["The supplied description uses a steel core molecularly bonded with high-purity electrolytic copper. A copper-coated inner flat electrode and crystalline conductive backfill are used in the chemical-electrode configuration to support conductivity and moisture retention."],"bullets":["Copper coating is specified at 100–250 microns, with 15+ years durability cited in the product notes.","Common diameters listed across the supplied notes include 48 mm, 58 mm and 76–100 mm; standard SPI product data lists 48 mm and 76 mm. Verify the available model.","Conductive backfill may use bentonite, graphite or carbon-based formulations; confirm that the selected compound is non-corrosive and compatible.","The intended benefits are corrosion resistance, low-maintenance operation and consistent dissipation in suitable soil conditions."],"note":"Actual earth resistance depends on soil, electrode geometry, compound and installation. It must be measured and verified at the site."}],"image":"/products/copper-bonded-chemical-earth-electrode.jpg","imageAlt":"Placeholder image for copper bonded chemical earth electrode"},{"id":9,"slug":"gi-earth-electrode","name":"GI Earth Electrode","category":"Earthing","summary":"Hot-dip galvanized earth electrode with moisture booster chemical bags.","description":"A galvanized iron rod or pipe electrode for safely dissipating fault or leakage current into the earth. The zinc coating helps resist corrosion in soil and moisture; choose a solid or perforated design and install it according to site conditions and the grounding design.","specifications":[{"label":"Diameters","value":"48 / 58 / 76 mm"},{"label":"Other typical sizes in supplied notes","value":"25–50 mm diameter and 2–3 m lengths are cited; confirm the exact SPI variant before specification"},{"label":"Lengths","value":"1 / 2 / 3 m"},{"label":"Finish","value":"Hot-dip galvanized"},{"label":"Included","value":"Moisture booster chemical bags"},{"label":"Soil pH suitability","value":"5.0–8.0"},{"label":"Testing","value":"NABL & CPRI tested"}],"features":["Supports fault current dissipation","Low maintenance","Moisture booster chemical bags","Vertical or horizontal installation as per site design","Zinc coating helps protect the iron body from soil and moisture corrosion","Cost-effective option for residential, commercial and industrial installations"],"applications":["Residential and commercial buildings","Power substations and distribution networks","Solar power systems","Industrial electrical installations"],"guideSections":[{"title":"Construction, installation and applications","paragraphs":["GI earth electrodes are supplied as solid rods or pipe-style electrodes. Some pipe designs include punched holes or slots to increase contact area or allow moisture and compatible backfill to distribute around the electrode. The supplied SPI range also includes moisture-booster bags on selected models."],"bullets":["Galvanized zinc coating is intended to improve resistance to corrosion caused by soil and moisture.","The supplied notes cite 25–50 mm diameters and 2–3 m lengths as typical; the SPI catalogue separately lists 48, 58 and 76 mm diameters and 1, 2 and 3 m lengths.","An electrode can be installed vertically or horizontally when the site-specific design calls for it.","Connect the electrode to the grounding conductor using a compatible connection and follow the electrical design and applicable local code.","Typical uses include homes, offices, industrial sites, substations, distribution networks and solar installations."],"note":"Dimensions, construction type and corrosion performance vary by model and soil conditions. Confirm the offered variant and applicable standard with SPI."}],"image":"/products/gi-earth-electrode.jpg","imageAlt":"Placeholder image for GI earth electrode"}]}]
