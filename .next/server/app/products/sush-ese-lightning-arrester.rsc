b:["$","$L16",null,{"product":{"id":2,"slug":"sush-ese-lightning-arrester","name":"Sush ESE Lightning Arrester","category":"Lightning Protection","summary":"All-weather 304L stainless steel ESE arrester with mechanical and environmental testing.","description":"A robust ESE lightning arrester manufactured in 304L (Inox) stainless steel and designed for demanding outdoor installations.","specifications":[{"label":"Material","value":"304L (Inox) stainless steel"},{"label":"Impulse current","value":"200kA (10/350µs)"},{"label":"Advance time (AT)","value":"60 µs"},{"label":"Salt mist test","value":"3 cycles / 72 hrs"},{"label":"Humid sulphur test","value":"7 cycles / 168 hrs"},{"label":"Mechanical test","value":"Passed"},{"label":"Conductor compatibility","value":"Tape/strip, round conductor, isolated/insulated cables and HV shielded cables"}],"features":["All-weather construction","Mechanical test passed","Salt mist and humid sulphur tested","Compatible with multiple down-conductor types"],"image":"/products/sush-ese-lightning-arrester.jpg","imageAlt":"Placeholder image for Sush ESE lightning arrester"},"relatedProducts":[{"id":1,"slug":"surya-power-ese-lightning-arrester","name":"Surya Power ESE Lightning Arrester (Surya Power Guard)","category":"Lightning Protection","summary":"Early Streamer Emission terminal with ion generation channels, carrying lightning up to 200kA safely to ground.","description":"An autonomous Early Streamer Emission (ESE) terminal that uses ion generation channels to safely carry lightning currents up to 200kA to ground.","specifications":[{"label":"Material","value":"Stainless Steel"},{"label":"Weight","value":"4.20 kg"},{"label":"External diameter","value":"187 mm"},{"label":"Length","value":"63 cm"},{"label":"Box length","value":"67 cm"},{"label":"Rod diameter","value":"20 mm"},{"label":"Adapter","value":"65.5 mm male"},{"label":"Ingress protection","value":"IP67"},{"label":"Working temperature","value":"-25°C to 90°C"},{"label":"Type","value":"Electroatmospheric"},{"label":"Internal insulation","value":"High Density Polyurethane Resin"},{"label":"Standard","value":"NFC 17-102/2011"},{"label":"Grounding","value":"Wire/Tape"},{"label":"Maximum current withstand","value":"200kA (10/350µs)"},{"label":"Advance time (AT)","value":"60 µs"}],"features":["High salt mist treatment","Humid sulphurous atmosphere treatment","High voltage impulse emitter","ION generator unit","Completely autonomous","30% more efficient than passive systems","Testable with iTorrent testers","20-year manufacturer warranty","Tested per NFC 17-102/2011 (DeltaT advance time test, current withstand test)"],"guideSections":[{"title":"Operating principle","paragraphs":["The ESE terminal described in the supplied SPI material uses an ion-generation system to encourage an upward streamer during a thunderstorm. Its purpose is to provide a designated interception point; the lightning current still needs a correctly designed down-conductor and earth-termination path."],"steps":["Ambient electric charge builds around the terminal during storm conditions.","The ESE unit emits an upward streamer earlier, as described by its tested advance-time rating.","The terminal intercepts a strike within the designed protection zone.","Down conductors and the earthing system route current safely toward the ground."],"note":"Protection depends on site layout, installation height, bonding, down-conductor routing, earthing and the applicable design standard. A terminal does not guarantee that lightning will not strike."},{"title":"ESE and conventional air terminals","table":{"headers":["Consideration","ESE terminal","Conventional terminal"],"rows":[["Operating approach","Active early-streamer-emission design","Passive air-terminal design"],["Design reference","NFC 17-102/2011","IEC 62305 design method"],["Protection zone","Calculated using validated advance time, height and protection level","Calculated from terminal geometry, height and protection level"],["Installation","Requires down conductors and a coordinated earth termination","Requires down conductors and a coordinated earth termination"]]},"bullets":["Protection radius depends on mounting height above the protected structure.","Protection level (I–IV) changes the radius calculation.","For ESE designs, the tested advance time (ΔT/AT) is a key input.","ESE advance-time examples in the supplied notes include 15, 30, 45 and 60 µs; use the tested value for the exact terminal.","Some supplied material references UNE 21186 as well as NFC 17-102; confirm which standard is accepted for the project.","Product and installation cost depend on the selected system and project; compare complete designs, not only terminal prices."],"note":"Use calculations permitted by the project standard and have the final protection design reviewed by a qualified lightning-protection professional."}],"applications":["High-rise buildings","Airports","Naval bases","Open areas","Critical military zones","Stadiums","Highways"],"image":"/products/surya-power-ese-lightning-arrester.jpg","imageAlt":"Placeholder image for Surya Power ESE lightning arrester","protectionRadius":[{"height":2,"level1":31,"level2":35,"level3":39,"level4":43},{"height":3,"level1":47,"level2":52,"level3":58,"level4":64},{"height":5,"level1":79,"level2":86,"level3":97,"level4":107},{"height":10,"level1":79,"level2":88,"level3":99,"level4":109},{"height":20,"level1":80,"level2":89,"level3":102,"level4":113}]},{"id":3,"slug":"surya-power-sigmatech-lightning-arrester","name":"Surya Power Sigmatech Lightning Arrester","category":"Lightning Protection","summary":"NFC 17-102/2011 compliant Sigmatech ESE terminal rated for 200kA.","description":"The Sigmatech model combines a stainless steel 316 body, tested current discharge, and ESE performance for a wide range of structures.","specifications":[{"label":"Model","value":"Sigmatech"},{"label":"Standard","value":"NFC 17-102/2011"},{"label":"Maximum current","value":"200kA"},{"label":"Advance time (AT)","value":"60 µs"},{"label":"Material","value":"Stainless Steel 316"},{"label":"Weight","value":"2.9 kg"},{"label":"External diameter","value":"194 mm"},{"label":"Height","value":"627 mm"},{"label":"Box length","value":"81 cm"},{"label":"Rod diameter","value":"20 mm"},{"label":"Adapter","value":"60 mm male"},{"label":"Ingress protection","value":"IP67"},{"label":"Protection radius method","value":"NFC 17-102 (Sept 2011): Rp = sqrt(h(2D-h) + ΔL(2D+ΔL)); D = 20m (Level I), 30m (II), 45m (III), 60m (IV)"}],"features":["+ve and -ve current discharge test","Time lag/DeltaT gain measurement","30% more efficient than passive systems","Testable with ORBITAL testers","20-year warranty"],"guideSections":[{"title":"Product identification and supplied reference notes","paragraphs":["The SPI product in this catalogue is the stainless-steel Sigmatech ESE terminal described by the specifications above. The supplied notes also include information about a separate third-party Sigmatech automation vendor and electrical surge-protection devices. That material does not establish an SPI affiliation, product equivalence or SPI specification.","General third-party selection references mention Type 1/Class B devices, coordinated B+C protection, spark-gap modules, MOV components and indicators. These are electrical surge-protection devices and are not the same product as an ESE roof terminal."],"bullets":["For a separate electrical surge-protection device, confirm the system topology (such as TN-S, TT or IT) and applicable standard.","Check device type, impulse current waveform/rating and coordination between upstream and downstream protection.","Confirm any isolator, status indicator, follow-current limitation or voltage-protection rating against the exact manufacturer datasheet.","The supplied third-party notes describe some combined B+C devices as using MOV components and claim voltage limitation below 1.5 kV at 50 kA; this is unverified third-party information and must be checked against the exact device certificate.","The supplied third-party notes reference DIN EN 61643-11, VDE and IEC; verify current editions and certificates for the selected device."],"note":"The third-party company profile, model claims and external references in the supplied text are not independently verified and must not be used as SPI product claims. Select electrical SPDs separately from structural lightning air terminals."}],"image":"/products/surya-power-sigmatech-lightning-arrester.jpg","imageAlt":"Placeholder image for Surya Power Sigmatech lightning arrester"},{"id":4,"slug":"surya-power-digital-lightning-strike-counter","name":"Surya Power Digital Lightning Strike Counter","category":"Lightning Protection","summary":"IP67 waterproof six-digit counter for recording lightning strike events.","description":"A rugged digital strike counter with a six-digit display for monitoring lightning current events on a protection system.","specifications":[{"label":"Display","value":"6-digit"},{"label":"Count range","value":"0–999999"},{"label":"Current sensitivity","value":"300A (8/20µs)"},{"label":"Alternate sensitivity in supplied notes","value":"500A (8/20µs) is also listed; verify the exact model datasheet"},{"label":"Operating range","value":"1500A to 200kA"},{"label":"Impulse waveform note","value":"Supplementary notes cite an 8/20µs measurement; confirm the rating and test waveform for the model"},{"label":"Ingress protection","value":"IP67 waterproof"},{"label":"Operating temperature","value":"-40 to +85°C"},{"label":"Humidity","value":"≤95%"},{"label":"Dimensions","value":"100 x 68 x 70 mm"},{"label":"Weight","value":"0.67 kg"},{"label":"Mounting","value":"6–10 mm cable or 50 x 5 mm tape"},{"label":"Warranty","value":"5 years"},{"label":"Display note","value":"The supplied notes also mention an 8-digit screen; the 0–999999 count range is six digits, so confirm the display specification"}],"features":["Waterproof enclosure","Six-digit event display","5-year warranty","Suitable for monitoring strike activity and supporting inspection or maintenance records","Testable with compatible SPI testing units as stated in the supplied notes"],"guideSections":[{"title":"How a strike counter records events","paragraphs":["Lightning counters detect the surge current on a down conductor and increment a stored event count. Common counter designs may use a current transformer, Rogowski coil or Hall-effect sensor, followed by signal conditioning and a display/counter circuit; the exact sensing method depends on the selected model."],"bullets":["Some advanced counters may include event timestamps, non-volatile logs, tamper-resistant enclosures or communications such as RS-485, GSM or LoRa.","Power options can vary across models; battery or solar-powered variants mentioned in general notes are not confirmed for this SPI counter.","The supplied material also mentions remote logging, maintenance scheduling and insurance/safety monitoring as general counter uses.","Use a compatible current path and mounting position as specified in the product instructions."],"note":"The supplied product notes conflict on display digits (six versus eight) and sensitivity (300A versus 500A). The 0–999999 count range supports six displayed digits; confirm the exact sensor threshold and display against the model datasheet before ordering."}],"image":"/products/digital-lightning-strike-counter.jpg","imageAlt":"Placeholder image for digital lightning strike counter"}]}]
