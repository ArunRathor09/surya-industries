b:["$","$L16",null,{"product":{"id":15,"slug":"earthing-pit-covers","name":"Earthing Pit Covers","category":"Accessories","summary":"UV-resistant, chemical-resistant earthing pit covers in HDPE and polymer options.","description":"Pit covers manufactured to IEC 62561-5:2018, with UV and chemical resistance and a 2-screw fixing design.","specifications":[{"label":"Standard","value":"IEC 62561-5:2018"},{"label":"Features","value":"UV resistant, chemical resistant, 2-screw fixing"},{"label":"Additional variants","value":"CI, PVC and FRP covers are also mentioned in supplementary notes; confirm material, load rating and availability with SPI"},{"label":"SPI Micro 6”","value":"155D x 230H x 240B mm, 0.4 kg, HDPE"},{"label":"Mini 7”","value":"177 x 230 x 270 mm, 0.7 kg, HDPE"},{"label":"Big 11”","value":"260 x 265 x 340 mm, 1.2 kg, HDPE"},{"label":"Square","value":"300 x 300 x 275 mm, 2.2 kg, HDPE"},{"label":"PEP-S","value":"245 x 245 x 195 mm, 2.4 kg, Polymer"},{"label":"PEP","value":"308 x 308 x 215 mm, 2.5 kg, Polymer"},{"label":"PEP-B 300","value":"500 x 500 x 315 mm, 5.0 kg, Polymer"}],"features":["UV and chemical resistant","2-screw fixing on the supplied SPI range","Helps prevent debris and accidental access while keeping the pit available for inspection","Load-bearing capacity varies by cover type and installation location"],"applications":["Electrical substations","Residential and commercial buildings","Telecommunication towers","Solar installations and industrial facilities"],"guideSections":[{"title":"Materials, load ratings and access","paragraphs":["An earth-pit cover protects the electrode connection and pit from debris, accidental access and tampering while keeping the inspection point accessible. The SPI sizes and materials are listed in the specifications above."],"bullets":["General cover materials in the supplied notes include concrete, cast iron, FRP, PVC/plastic, HDPE and polymer.","Load rating must suit the location: pedestrian areas and vehicle routes require different cover classes.","Covers may have lifting hooks or handles; lockable designs are available on some products.","Common installations include substations, buildings, telecom towers, solar sites and industrial facilities.","A correctly selected cover helps keep water or debris out and reduces the chance of accidental contact with pit components."],"note":"Material, dimensions, fixing type and load-bearing capacity differ by model. Confirm the exact cover class for the intended location."}],"image":"/products/earthing-pit-covers.jpg","imageAlt":"Placeholder image for earthing pit covers"},"relatedProducts":[{"id":6,"slug":"ese-lightning-arrester-installation-accessories","name":"ESE LA Installation Accessories","category":"Accessories","summary":"Mounting and connection components for ESE lightning arrester installations.","description":"A range of installation accessories to support secure mounting and conductor routing for ESE lightning arresters.","specifications":[{"label":"Available accessories","value":"Insulator, U Clamp, U Anchor Bolt, Anchor Bolt, Stray Wire, GI Mast"}],"features":["Selection of installation hardware","For ESE LA installations"],"image":"/products/ese-installation-accessories.jpg","imageAlt":"Placeholder image for ESE lightning arrester installation accessories"}]}]
